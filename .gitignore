# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.pytest-cache/
*.egg-info/
build/

# Gateway conformance runner writes a per-run duration map (absolute tmp paths)
test_durations.json

# Serialize web UI builds across concurrent `hermes dashboard` invocations
.web_ui_build.lock

# Frontend dependency + build artifacts (built via `cd web && npm run build`;
# resolved at runtime from the source checkout — not shipped in the wheel)
node_modules/
hermes_cli/web_dist/

# Build/test artifacts (bytecode hash of the checked-out tree; regenerated on every commit)
.bytecode-fingerprint

# First-run bootstrap marker — `git stash -u` (hermes update autostash) must skip it
.hermes-bootstrap-complete
dist/
